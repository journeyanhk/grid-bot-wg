# ─────────────────────────────────────────────────────────────
# 三交易所网格交易机器人 · systemd 服务
# 部署: /root/grid-bot-wg（用户 root，勿改 User）
#
# 使用步骤（VPS 上执行）:
#   1. 上传项目到 /root/grid-bot-wg 并安装运行时依赖:
#        cd /root/grid-bot-wg && npm install --omit=dev
#   2. 配置 .env（务必设置 HOST=0.0.0.0 / DASHBOARD_TOKEN / PUBLIC_ORIGIN，
#      VPS 安全要求见 README「VPS / 公网部署安全配置」）:
#        cp .env.example .env && 编辑 .env
#   3. 安装并启动服务:
#        cp deploy/grid-bot.service /etc/systemd/system/
#        systemctl daemon-reload
#        systemctl enable --now grid-bot
#   4. 查看:
#        状态:   systemctl status grid-bot
#        日志:   journalctl -u grid-bot -f      （程序自身也写 logs/ 目录）
#        重启:   systemctl restart grid-bot     （改 .env 后需重启生效）
#   5. 停止/禁用:
#        systemctl stop grid-bot
#        systemctl disable grid-bot
#
# 注意: 本机 node 路径若非 /usr/bin/node（如 nvm 安装），先执行
#       `which node` 拿到绝对路径并替换下方 ExecStart。
# ─────────────────────────────────────────────────────────────

[Unit]
Description=Grid Bot All - 三交易所网格交易机器人
Documentation=https://github.com/journeyanhk/grid-bot-wg
# 等待网络就绪再启动（机器人启动即连接交易所 API）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 项目部署目录
WorkingDirectory=/root/grid-bot-wg
# 以 root 运行（项目在 /root 下；README 强调私钥只存本机 .env，权限自担）
User=root
Group=root
# node 绝对路径（`which node` 确认；nvm 安装请改为实际路径）
ExecStart=/usr/bin/node src/server.js
# 崩溃/被杀自动拉起，10 秒后重试
Restart=always
RestartSec=10
# systemctl stop 时最多等 15s（留时间让状态快照落盘）
TimeoutStopSec=15
# 日志进 journald（journalctl -u grid-bot -f 查看）；程序自身也写 logs/
StandardOutput=journal
StandardError=journal
# 长跑轮询 + SSE 连接，放开文件描述符上限
LimitNOFILE=65535
# 安全加固：禁止提权、私有 /tmp
NoNewPrivileges=true
PrivateTmp=true
# 根文件系统只读，仅放行项目目录可写（.state.json / logs/ 写这里）
ProtectSystem=strict
ReadWritePaths=/root/grid-bot-wg

[Install]
WantedBy=multi-user.target
