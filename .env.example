# ═══════════════════════════════════════════════════════════
# 三交易所整合网格机器人 · 配置文件
# 复制本文件为 .env 并填入对应值
# ═══════════════════════════════════════════════════════════

# 服务端口（默认 8080）
PORT=8080

# 监听地址（默认 127.0.0.1 仅本机；VPS 部署设为 0.0.0.0）
# HOST=127.0.0.1

# ── 仪表盘鉴权（VPS / 公网部署必配）─────────────────────
# 账号密码模式（推荐）：配置后浏览器打开需用账号密码登录，换取会话令牌
# （默认 12 小时有效，可用 DASHBOARD_SESSION_MS 调整毫秒数）。
# 生成密码建议：openssl rand -base64 16
DASHBOARD_USER=
DASHBOARD_PASS=
DASHBOARD_SESSION_MS=43200000
# 兼容模式：仅配置 DASHBOARD_TOKEN 时退化为静态令牌（前端首次输入后会话内有效）
# DASHBOARD_TOKEN=
# 允许的页面来源 Origin（逗号分隔）。通过域名/HTTPS 访问时配置，如：
# PUBLIC_ORIGIN=https://grid-bot-wg.032588.xyz
# 不配置时仅允许从本机(localhost)来源访问页面。
PUBLIC_ORIGIN=

# 模拟账户初始余额 USDC（paper 模式共用）
PAPER_BALANCE=10000

# ── 日志（可选）────────────────────────────────────────
# 日志级别：error | warn | info | debug（默认 info）
# 日志目录（默认 ./logs，按天轮转 JSON lines）
LOG_LEVEL=info
LOG_DIR=logs

# ── 代理 / IP 配置 ────────────────────────────────────────
# 全局代理：同时应用于所有三个交易所（优先级最高）
# 留空则各交易所使用各自的独立代理配置
# 支持格式：
#   HTTP(S):  http://127.0.0.1:7890
#   SOCKS5:   socks5://127.0.0.1:1080
#   带认证:   socks5://user:pass@host:port
#   简写格式: host:port:user:pass
GLOBAL_PROXY=

# 各交易所独立代理（仅在 GLOBAL_PROXY 未设置时生效）
DECIBEL_PROXY=
EXTENDED_PROXY=
RISEX_PROXY=

# ── Decibel 交易所 ────────────────────────────────────────
# 运行模式：paper（模拟）| live（实盘）
DE_MODE=paper
# 网络：mainnet | testnet
DE_NETWORK=mainnet

# 实盘凭据（DE_MODE=live 时必填）
# API Key：在 geomi.dev 创建
DECIBEL_API_KEY=
# API 钱包 Ed25519 私钥：在 app.decibel.trade/api 创建
DECIBEL_PRIVATE_KEY=
# Trading Account 地址
DECIBEL_SUBACCOUNT=
# 自定义 API URL（留空使用默认）
DECIBEL_API_URL=

# ── Extended 交易所 ───────────────────────────────────────
EX_MODE=paper
EX_NETWORK=mainnet

# 实盘凭据（EX_MODE=live 时必填）
# 在 app.extended.exchange → API Management 获取
EXTENDED_API_KEY=
EXTENDED_VAULT=
EXTENDED_STARK_PRIVATE_KEY=
EXTENDED_STARK_PUBLIC_KEY=
EXTENDED_MAX_FEE=0.0005
EXTENDED_API_URL=

# ── RISEx 交易所 ──────────────────────────────────────────
RS_MODE=paper
RS_NETWORK=mainnet

# 实盘凭据（RS_MODE=live 时必填）
ACCOUNT_ADDRESS=
SIGNER_PRIVATE_KEY=
RISEX_API_URL=
RISEX_WS_URL=

# ── RHC Lighter 交易所 ──────────────────────────────────────
# 运行模式：paper（模拟）| live（实盘）；RHC 固定官方主网
LR_MODE=paper
# 实盘凭据（LR_MODE=live 时必填）
# accountIndex：账户索引（数字）；apiKeyIndex：API Key 索引（4-254，0-3 平台保留）
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=
# API 签名私钥（或私钥文件路径，二选一）
LIGHTER_API_PRIVATE_KEY=
LIGHTER_API_PRIVATE_KEY_FILE=
# Python 解释器路径（RHC 实盘需要 Python 3.12+ 与 lighter-sdk；留空用系统默认）
LIGHTER_PYTHON=
LIGHTER_FEE_RATE=0.0005
LIGHTER_PROXY=

# ── Hyperliquid / Entropy (HL) ────────────────────────────────────────────
# 实盘模式：HL_MODE=live（默认 paper）。接入 io dex（HIP-3 建设者市场，如 io:ANTH）。
# agent 钱包：在 Hyperliquid 官网创建 agent wallet（主钱包授权"可交易、不可提现"），
# 签名器只持 agent 私钥。
HL_MODE=paper
# agent 钱包地址（live 必填）
HL_ACCOUNT_ADDRESS=
# agent 私钥（或私钥文件路径，二选一；live 必填）
HL_AGENT_PRIVATE_KEY=
HL_AGENT_PRIVATE_KEY_FILE=
# dex 命名空间（默认 io；core 市场留空即不筛选时请显式设置）
HL_DEX=io
# Python 解释器路径（HL 实盘需要 Python 3.12+ 与 hyperliquid-python-sdk；留空用系统默认）
HL_PYTHON=
HL_FEE_RATE=0.0005
HL_PROXY=

# ── Variational Omni（VA）────────────────────────────────────────────
# RFQ/OLP 报价模型（无订单簿），全有或全无限价单，零手续费（点差成本）。
# LIVE 鉴权用 vr-token cookie：登录 omni.variational.io 后从浏览器复制。
# 精度默认保守，实盘校验前不要放大下单量。
VA_MODE=paper
VA_BASE_URL=https://omni.variational.io
# 逗号分隔的标的（默认 BTC）
VA_UNDERLYINGS=BTC
# 实盘凭据（VA_MODE=live 时必填）：登录后的 vr-token cookie
VARIATIONAL_TOKEN=
# 钱包地址：SIWE 自动登录必填（须与 VA_WALLET_PRIVATE_KEY 推导地址一致）；贴 token 方案可留空
VA_ADDRESS=
# 独立热钱包私钥（0x 开头）：配了它即可无人值守自动登录（每 ~6 天自签一次 vr-token）。
# 安全：仅放在服务器（与其他所私钥一致），仪表盘 /api/env 不可读写此项；爆炸半径=本钱包余额。
# 只贴 token 不用自动登录可留空。
VA_WALLET_PRIVATE_KEY=
# 自动登录得到的 token 落盘路径（600 权限，重启复用，减少登录频次）。默认即可。
VA_TOKEN_CACHE=.runtime/va_token.json
# 下单滑点上限（相对报价），默认 0.005 = 0.5%
VA_SLIPPAGE_LIMIT=0.005
VA_LEVERAGE=
# 传输层：Omni 在 Cloudflare 后，Node 直连会被 403。bridge = 启动 Python
# (curl_cffi, Chrome 指纹) 子进程，是唯一能过 CF 的模式；node = 纯 fetch（会被拦，仅备查）。
# 需先安装依赖：pip install curl_cffi（装到 VA_PYTHON 指向的那个解释器里）
VA_TRANSPORT=bridge
# 指定装有 curl_cffi 的 python 解释器（同 HL_PYTHON）。留空则自动探测
# .va-venv/.runtime/python，找不到再退回 PATH 上的 python3。
# 服务器若报「无法加载 curl_cffi」，就把这里指到你的虚拟环境，如：
#   VA_PYTHON=/opt/grid/.va-venv/bin/python3
VA_PYTHON=
# 单合约单一订单类型的挂单硬上限（探针实测 50，第 51 单被 HTTP 422 拒）。
# 一般无需改；网格数需 ≤ 该值−5（预留补格/回收阶梯额度）。
VA_MAX_OPEN_ORDERS=50
# 合约身份（一般无需改动）；BTC 永续不要设置 VA_KIND
VA_INSTRUMENT_TYPE=perpetual_future
VA_SETTLEMENT_ASSET=USDC
VA_FUNDING_INTERVAL_S=
VA_KIND=
VA_FEE_RATE=0.0001
VA_PROXY=

# ── AI 助手（可选：风控哨兵/日报/市况分析/对话操控/出区间建议）──
# 协议类型：openai | anthropic | gemini
#   openai = 所有 OpenAI 兼容服务（OpenAI/DeepSeek/Kimi/通义/智谱/OpenRouter/Ollama 等）
AI_PROVIDER=openai
AI_API_KEY=
# 接口地址（留空用官方默认）。示例：
#   DeepSeek: https://api.deepseek.com/v1    Kimi: https://api.moonshot.cn/v1
#   通义: https://dashscope.aliyuncs.com/compatible-mode/v1
#   Ollama 本地: http://127.0.0.1:11434/v1
AI_BASE_URL=
# 主模型（复盘/分析/对话）与小模型（哨兵巡检，高频省钱，可留空同主模型）
AI_MODEL=
AI_MODEL_SMALL=
# 哨兵巡检间隔（分钟，0=关闭）；BTC 市况报告间隔（分钟，0=关闭）；日报生成时间（0-23 整点）
AI_SENTINEL_MINUTES=5
AI_MARKET_MINUTES=30
AI_REPORT_HOUR=20

# 通知推送（可选，配了才会推）：Telegram 机器人 + 通用 Webhook（POST {"text":...}）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK=
# Server酱（微信推送）SendKey：经典 Turbo 填 SCT... / 新版 Server酱³ 填 sctp...
SERVERCHAN_SENDKEY=
# 事件日历：CPI/FOMC/非农 前后各多少分钟预警（默认 30）
CALENDAR_ALERT_MINUTES=30
# 事件窗口内是否自动暂停入场侧（默认 off，仅通知不动手；on=窗口内暂停开仓、保留出场腿）
CALENDAR_AUTO_PAUSE=off
